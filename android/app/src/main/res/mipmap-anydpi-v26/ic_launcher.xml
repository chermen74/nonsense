<?xml version="1.0" encoding="utf-8"?>
<!--
  His face, with an aura around it. All three layers are generated from the
  one photograph by tools/icon.mjs, so the icon can be adjusted by changing a
  number rather than by re-exporting a binary nobody can edit.

  The ground and its warm wash are the background layer, where a launcher's
  mask can crop them at no cost; he is on the foreground, laid inside the 66dp
  circle that every mask is guaranteed to keep.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
